# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.

# PostgreSQL 접속 문자열 (Supabase / Neon / Render 등)
# 없으면 데모 모드(pg-mem, 메모리)로 뜬다 — 서버가 다시 뜨면 가입한 계정이 사라진다.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT 서명 키 — 아무한테도 보여주면 안 된다.
# 만드는 법:  node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 토큰 수명 (선택)
ACCESS_TTL_MIN=15      # 액세스 토큰 15분
REFRESH_TTL_DAYS=14    # 리프레시 토큰 14일

# PGSSL=off    # 로컬 DB 인데 SSL 오류가 나면
# PORT=8792
